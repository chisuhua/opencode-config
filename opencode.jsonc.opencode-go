{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "model": "minimax-cn/MiniMax-M3.1-Flash",
  "default_agent": "build",
  "experimental": {
    "subagent_depth": 2
  },
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "/home/ubuntu/.local/bin/codebase-memory-mcp"
      ],
      "timeout": 30000
    }
  },
  "permission": {
    "codebase-memory-mcp_*": "deny",
    "codebase-memory-mcp_search_graph": "allow",
    "codebase-memory-mcp_get_code_snippet": "allow",
    "codebase-memory-mcp_trace_path": "allow",
    "codebase-memory-mcp_get_architecture": "allow",
    "codebase-memory-mcp_get_graph_schema": "allow",
    "codebase-memory-mcp_query_graph": "allow",
    "codebase-memory-mcp_search_code": "allow",
    "codebase-memory-mcp_detect_changes": "allow",
    "codebase-memory-mcp_list_projects": "allow",
    "codebase-memory-mcp_index_status": "allow",
    "delegate": "deny",
    "delegate_dispatch": "deny",
    "delegate_sessions": "deny",
    "delegate_suspend": "deny",
    "delegate_cancel": "deny"
  },
  "agent": {
    "build": {
      "model": "minimax-cn/MiniMax-M3.1-Flash",
      "temperature": 0.1,
      "mode": "primary",
      "hidden": false,
      "description": "主对话 agent。代码编写、修改、调试、提交。shell 默认 allow；危险命令、.env 读取、MCP 写操作需 ask。",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "edit": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "shell": {
          "*": "allow",
          "git push *": "ask",
          "git push": "ask",
          "git reset --hard *": "ask",
          "git reset --hard": "ask",
          "git clean -fd *": "ask",
          "git clean -fd": "ask",
          "git clean -fdx *": "ask",
          "git clean -fdx": "ask",
          "git checkout -- *": "ask",
          "git checkout .": "ask",
          "git restore *": "ask",
          "git branch -D *": "ask",
          "git stash drop *": "ask",
          "git stash clear *": "ask",
          "rm -rf *": "ask",
          "rm -fr *": "ask",
          "rm -r *": "ask",
          "rm -f *": "ask",
          "sudo *": "ask",
          "cat *.env": "ask",
          "cat *.env.*": "ask",
          "head *.env": "ask",
          "head *.env.*": "ask",
          "tail *.env": "ask",
          "tail *.env.*": "ask"
        },
        "subagent": "allow",
        "external_directory": "ask",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow",
        "question": "allow",
        "codebase-memory-mcp_index_repository": "ask",
        "codebase-memory-mcp_ingest_traces": "ask",
        "codebase-memory-mcp_manage_adr": "ask",
        "codebase-memory-mcp_delete_project": "ask"
      },
      "prompt": "{file:./prompts/build.md}"
    },
    "plan": {
      "model": "minimax-cn/MiniMax-M3.1-Flash",
      "mode": "primary",
      "hidden": false,
      "description": "设计者与方案规划 agent。只读地探索代码、评估取舍、产出可验证的实施计划。",
